DOCKER_INFLUXDB_INIT_MODE=setup

## Environment variables used during the setup and operation of the stack
#

# Primary InfluxDB admin/superuser credentials
#
DOCKER_INFLUXDB_INIT_USERNAME=your_influx_username
DOCKER_INFLUXDB_INIT_PASSWORD=your_influx_password
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=your_influx_admin_token # in cmd run "openssl rand -hex 32"

# Primary InfluxDB organization & bucket definitions
# 
DOCKER_INFLUXDB_INIT_ORG=lnec-artemis
DOCKER_INFLUXDB_INIT_BUCKET=telegraf
# Primary InfluxDB bucket retention period
#
# NOTE: Valid units are nanoseconds (ns), microseconds(us), milliseconds (ms)
# seconds (s), minutes (m), hours (h), days (d), and weeks (w).
# if not set it is forever
DOCKER_INFLUXDB_INIT_RETENTION=15000d 

# InfluxDB port & hostname definitions
#
DOCKER_INFLUXDB_INIT_PORT=8086
DOCKER_INFLUXDB_INIT_HOST=influxdb

# InfluxDB tasks
#DOCKER_INFLUXDB_TASK1=./influxdb/flux/disp_results_task.flux

# Telegraf configuration file
# 
# Will be mounted to container and used as telegraf configuration
TELEGRAF_CFG_PATH=./telegraf/telegraf.conf
TELEGRAF_METRICS_PATH=./telegraf/metrics.out
TELEGRAF_JSON_PATH=./telegraf/test.json
SET1_API_URL=http://cetus:11001/api/services/measurements/sensores/
SET2_API_URL=http://cetus:11001/api/services/measurements/sensores/

# MQTT broker credentials for Telegraf
MQTT_SERVER_URL=ssl://5af0da191bba4efe89e7bdd05d71b054.s1.eu.hivemq.cloud:8883
MQTT_CLIENT_ID=telegraf
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Mosquitto configuration file
# 
# Will be mounted to container and used as mosquito configuration
#MOSQUITTO_CFG_PATH=./mosquitto/config/mosquitto.conf
#MOSQUITTO_PWD_PATH=./mosquitto/config/pwdfile

# Grafana port definition
GRAFANA_PORT=3000

#NGROK token
NGROK_AUTHTOKEN=your_ngrok_auth_token
